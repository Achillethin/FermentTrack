# URL of the deployed FastAPI backend (no trailing slash). Baked in at build
# time by Vite — set this as a repo variable/secret for the GitHub Actions
# deploy workflow (see .github/workflows/deploy-frontend.yml).
VITE_API_URL=http://127.0.0.1:8000

# Supabase project URL + anon public key (Project Settings -> API). Used only
# for anonymous sign-in (frontend/src/auth.js) so each visitor's batches are
# private to them; both values are safe to expose client-side.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
